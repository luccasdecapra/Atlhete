// ── STORAGE ──────────────────────────────────────────
const STORAGE_KEY = 'luccas_checked_v2';
let checked = {};

function loadChecked() {
  try { checked = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch(e) { checked = {}; }
}
function saveChecked() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(checked)); } catch(e) {}
}

// ── RENDER ────────────────────────────────────────────
function renderItem(section, idx, item) {
  const key = section + '_' + idx;
  const isChecked = !!checked[key];
  const div = document.createElement('div');
  div.className = 'item' + (isChecked ? ' checked' : '');
  div.innerHTML = `
    <div class="checkbox"><span class="check-mark">✓</span></div>
    <div class="item-body">
      <div class="item-name">${item.name}</div>
      <div class="item-detail">${item.qty ? '<b style="color:var(--text-dim)">' + item.qty + '</b> · ' : ''}${item.detail}</div>
    </div>
    <div class="tag ${item.tag}">${item.label}</div>
  `;
  div.addEventListener('click', () => toggleItem(key, div, section));
  return div;
}

function toggleItem(key, el, section) {
  if (checked[key]) { delete checked[key]; el.classList.remove('checked'); }
  else { checked[key] = true; el.classList.add('checked'); }
  saveChecked();
  updateProgress();
  updateSectionCount(section);
}

function updateProgress() {
  const total = Object.values(LISTS).reduce((a,l) => a + l.length, 0);
  const done = Object.keys(checked).length;
  document.getElementById('progress-pill').textContent = done + '/' + total;
}

function updateSectionCount(section) {
  const map = {proteinas:'cnt-p', carbos:'cnt-c', gorduras:'cnt-g', recuperacao:'cnt-r', vegetais:'cnt-v', hidratacao:'cnt-h', praticidade:'cnt-pr'};
  const el = document.getElementById(map[section]);
  if (!el) return;
  const total = LISTS[section].length;
  const done = LISTS[section].filter((_,i) => !!checked[section+'_'+i]).length;
  el.textContent = done + '/' + total;
}

function renderAll() {
  Object.entries(LISTS).forEach(([section, items]) => {
    const container = document.getElementById('list-' + section);
    if (!container) return;
    container.innerHTML = '';
    items.forEach((item, idx) => container.appendChild(renderItem(section, idx, item)));
    updateSectionCount(section);
  });
  updateProgress();
}

function resetAll() {
  if (!confirm('Limpar todos os itens marcados?')) return;
  checked = {};
  saveChecked();
  renderAll();
}

