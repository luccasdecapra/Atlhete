<style>
:root {
  --bg: #0c0e0d;
  --surface: #131614;
  --surface2: #191c1a;
  --border: #222522;
  --border2: #2d312c;
  --orange: #e8834a;
  --orange-glow: rgba(232,131,74,0.15);
  --green: #7ec47a;
  --blue: #6ab3d4;
  --gold: #d4a843;
  --purple: #a87fd4;
  --red: #d46a6a;
  --text: #e4e2dd;
  --text-dim: #8a8e8b;
  --text-muted: #4e524f;
  --safe: env(safe-area-inset-bottom, 0px);
}

* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

html, body {
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-size: 15px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ── SPLASH ── */
#splash {
  position: fixed; inset: 0;
  background: var(--bg);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  z-index: 999;
  transition: opacity 0.5s ease;
}
#splash.hide { opacity: 0; pointer-events: none; }
.splash-icon {
  font-size: 48px;
  margin-bottom: 20px;
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.1)} }
.splash-title {
  font-family: 'Syne', sans-serif;
  font-size: 28px; font-weight: 800;
  color: var(--text);
  letter-spacing: -0.5px;
}
.splash-title span { color: var(--orange); }
.splash-sub {
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--text-muted);
  letter-spacing: 0.2em; margin-top: 8px;
}
.splash-bar {
  width: 120px; height: 2px;
  background: var(--border2);
  border-radius: 2px;
  margin-top: 32px; overflow: hidden;
}
.splash-fill {
  height: 100%; width: 0;
  background: var(--orange);
  border-radius: 2px;
  animation: load 1.2s ease forwards;
}
@keyframes load { to { width: 100%; } }

/* ── APP SHELL ── */
#app {
  display: flex; flex-direction: column;
  height: 100%; height: 100dvh;
}

/* ── HEADER ── */
.header {
  padding: 16px 20px 12px;
  padding-top: calc(16px + env(safe-area-inset-top, 0px));
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0;
  background: var(--bg);
}
.header-left { display: flex; align-items: center; gap: 10px; }
.header-icon {
  width: 34px; height: 34px;
  background: var(--orange-glow);
  border: 1px solid rgba(232,131,74,0.3);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
}
.header-title {
  font-family: 'Syne', sans-serif;
  font-size: 17px; font-weight: 800;
  letter-spacing: -0.3px;
}
.header-title span { color: var(--orange); }
.header-badge {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--text-muted);
  letter-spacing: 0.1em;
}
.progress-pill {
  background: var(--surface2);
  border: 1px solid var(--border2);
  border-radius: 20px;
  padding: 5px 12px;
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--orange);
  font-weight: 500;
}

/* ── TAB BAR ── */
.tabbar {
  display: flex;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  overflow-x: auto;
  scrollbar-width: none;
  background: var(--bg);
}
.tabbar::-webkit-scrollbar { display: none; }
.tab {
  flex: 0 0 auto;
  padding: 10px 16px;
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.12em;
  color: var(--text-muted);
  text-transform: uppercase;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  white-space: nowrap;
  transition: all 0.2s;
  display: flex; align-items: center; gap: 6px;
  user-select: none;
}
.tab.active {
  color: var(--orange);
  border-bottom-color: var(--orange);
}
.tab-emoji { font-size: 13px; }

/* ── PAGES ── */
.pages { flex: 1; overflow: hidden; position: relative; }
.page {
  position: absolute; inset: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 0 0 calc(20px + var(--safe));
  display: none;
}
.page.active { display: block; }

/* ── SECTION ── */
.section-head {
  position: sticky; top: 0; z-index: 10;
  background: var(--bg);
  padding: 12px 20px;
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 10px;
}
.section-emoji { font-size: 18px; }
.section-title {
  font-family: 'Syne', sans-serif;
  font-size: 14px; font-weight: 700;
  letter-spacing: -0.2px;
}
.section-count {
  margin-left: auto;
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--text-muted);
}

/* ── ITEMS ── */
.item-list { padding: 0 16px; }
.item {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 13px 4px;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  transition: background 0.15s;
  border-radius: 8px;
  margin: 2px 0;
}
.item:active { background: var(--surface); }
.item.checked .item-name { text-decoration: line-through; color: var(--text-muted); }
.item.checked .item-detail { color: var(--text-muted); opacity: 0.5; }
.checkbox {
  width: 22px; height: 22px; flex-shrink: 0;
  border: 1.5px solid var(--border2);
  border-radius: 6px;
  margin-top: 1px;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s;
}
.item.checked .checkbox {
  background: var(--orange);
  border-color: var(--orange);
}
.check-mark {
  color: white; font-size: 13px; font-weight: 700;
  opacity: 0; transform: scale(0.5);
  transition: all 0.15s;
}
.item.checked .check-mark { opacity: 1; transform: scale(1); }
.item-body { flex: 1; }
.item-name { font-size: 14px; font-weight: 500; transition: all 0.2s; }
.item-detail { font-size: 12px; color: var(--text-dim); margin-top: 2px; line-height: 1.4; }
.tag {
  font-family: 'DM Mono', monospace;
  font-size: 9px; letter-spacing: 0.06em;
  padding: 2px 7px; border-radius: 4px;
  white-space: nowrap; flex-shrink: 0; margin-top: 4px;
  align-self: flex-start;
}
.t-p { background: rgba(232,131,74,0.12); color: var(--orange); }
.t-c { background: rgba(212,168,67,0.12); color: var(--gold); }
.t-f { background: rgba(126,196,122,0.12); color: var(--green); }
.t-r { background: rgba(106,179,212,0.12); color: var(--blue); }
.t-m { background: rgba(168,127,212,0.12); color: var(--purple); }
.t-n { background: rgba(168,127,212,0.15); color: var(--purple); }
.t-s { background: rgba(212,100,100,0.12); color: var(--red); }
.t-e { background: rgba(212,168,67,0.15); color: var(--gold); }

/* ── RESET BTN ── */
.reset-wrap { padding: 16px 20px 0; }
.reset-btn {
  width: 100%; padding: 11px;
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 10px;
  color: var(--text-muted);
  font-family: 'DM Mono', monospace;
  font-size: 11px; letter-spacing: 0.1em;
  cursor: pointer;
  transition: all 0.2s;
}
.reset-btn:active { background: var(--surface2); color: var(--text); }

/* ── DIETA CARDS ── */
.meal-wrap { padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }
.meal-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
}
.meal-card-head {
  padding: 13px 16px;
  display: flex; align-items: center; gap: 10px;
  cursor: pointer;
}
.meal-card-head:active { background: var(--surface2); }
.meal-time {
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--orange);
  letter-spacing: 0.05em;
}
.meal-name { font-size: 14px; font-weight: 600; }
.meal-arrow {
  margin-left: auto; color: var(--text-muted);
  transition: transform 0.2s; font-size: 12px;
}
.meal-card.open .meal-arrow { transform: rotate(90deg); }
.meal-body {
  display: none;
  padding: 0 16px 14px;
  border-top: 1px solid var(--border);
}
.meal-card.open .meal-body { display: block; }
.meal-line {
  display: flex; gap: 8px;
  font-size: 13px; color: var(--text-dim);
  padding: 5px 0;
  border-bottom: 1px solid rgba(34,37,34,0.5);
}
.meal-line:last-child { border-bottom: none; }
.meal-line::before { content: '—'; color: var(--text-muted); flex-shrink: 0; }
.macro-row {
  display: flex; gap: 12px;
  margin-top: 10px; padding-top: 10px;
  border-top: 1px solid var(--border);
}
.macro { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--text-muted); }
.macro span { color: var(--orange); font-weight: 500; }

/* ── SUPLEMENTOS ── */
.supp-wrap { padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
.supp-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
  display: flex; flex-direction: column; gap: 4px;
}
.supp-top { display: flex; align-items: center; gap: 8px; }
.supp-name { font-size: 14px; font-weight: 600; flex: 1; }
.supp-dose {
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--green);
}
.supp-why { font-size: 12px; color: var(--text-muted); }
.supp-timing {
  font-family: 'DM Mono', monospace;
  font-size: 10px; letter-spacing: 0.08em;
  color: var(--blue);
  margin-top: 2px;
}

/* ── PROTOCOLO ── */
.proto-wrap { padding: 12px 16px; }
.proto-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
}
.proto-line {
  display: flex; gap: 14px;
  padding: 13px 16px;
  border-bottom: 1px solid var(--border);
  align-items: flex-start;
}
.proto-line:last-child { border-bottom: none; }
.proto-time {
  font-family: 'DM Mono', monospace;
  font-size: 11px; color: var(--orange);
  min-width: 52px; flex-shrink: 0;
  padding-top: 1px;
}
.proto-text { font-size: 13px; line-height: 1.5; }

/* ── GENES ── */
.gene-wrap { padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
.gene-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
}
.gene-top { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.gene-id {
  font-family: 'DM Mono', monospace;
  font-size: 10px; color: var(--orange);
  background: var(--orange-glow);
  padding: 2px 8px; border-radius: 4px;
}
.gene-geno { font-size: 13px; font-weight: 600; flex: 1; }
.gene-badge {
  font-family: 'DM Mono', monospace;
  font-size: 9px; padding: 2px 7px; border-radius: 4px;
}
.g-warn { background: rgba(212,100,100,0.1); color: var(--red); }
.g-ok { background: rgba(126,196,122,0.1); color: var(--green); }
.g-adapt { background: rgba(212,168,67,0.1); color: var(--gold); }
.g-care { background: rgba(106,179,212,0.1); color: var(--blue); }
.gene-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; }

/* ── ALERTAS ── */
.alert-wrap { padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
.alert-box {
  border-radius: 12px;
  padding: 14px 16px;
}
.alert-red { background: rgba(212,100,100,0.07); border: 1px solid rgba(212,100,100,0.2); }
.alert-gold { background: rgba(212,168,67,0.07); border: 1px solid rgba(212,168,67,0.2); }
.alert-green { background: rgba(126,196,122,0.07); border: 1px solid rgba(126,196,122,0.2); }
.alert-head { display: flex; gap: 8px; align-items: center; margin-bottom: 6px; }
.alert-emoji { font-size: 16px; }
.alert-title { font-size: 13px; font-weight: 600; }
.alert-body { font-size: 12px; color: var(--text-dim); line-height: 1.5; }
.alert-items { margin-top: 8px; display: flex; flex-direction: column; gap: 4px; }
.alert-item {
  display: flex; gap: 8px;
  font-size: 12px; color: var(--text-dim);
}
.alert-item::before { content: '•'; color: var(--text-muted); }

/* ── BOTTOM NAV ── */
.bottom-nav {
  display: flex;
  border-top: 1px solid var(--border);
  background: var(--bg);
  padding-bottom: var(--safe);
  flex-shrink: 0;
}
.nav-btn {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 10px 4px 8px;
  cursor: pointer;
  color: var(--text-muted);
  transition: color 0.2s;
  user-select: none;
}
.nav-btn.active { color: var(--orange); }
.nav-icon { font-size: 20px; line-height: 1; }
.nav-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px; letter-spacing: 0.08em;
  margin-top: 3px; text-transform: uppercase;
}

/* ── EMPTY ── */
.empty {
  text-align: center; padding: 60px 20px;
  color: var(--text-muted);
  font-family: 'DM Mono', monospace; font-size: 12px;
  letter-spacing: 0.1em;
}
.empty-icon { font-size: 36px; margin-bottom: 12px; }

/* ── INFO HEADER CARD ── */
.info-card {
  margin: 12px 16px;
  background: linear-gradient(135deg, rgba(232,131,74,0.08), rgba(126,196,122,0.04));
  border: 1px solid rgba(232,131,74,0.2);
  border-radius: 14px;
  padding: 16px;
}
.info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.info-stat { text-align: center; }
.info-val {
  font-family: 'Syne', sans-serif;
  font-size: 18px; font-weight: 800;
  color: var(--orange);
}
.info-lbl {
  font-family: 'DM Mono', monospace;
  font-size: 9px; color: var(--text-muted);
  letter-spacing: 0.1em; text-transform: uppercase;
  margin-top: 2px;
}
</style>

